#!/usr/bin/env bash
# Git pre-commit hook for Owlmic
# Enforces branch naming style:
# - Format: <type>/<short-kebab-description>
# - Types: feat, fix, docs, refactor, perf, test, chore
# - Limit: less than 6 words

BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

# Skip checks on detached HEAD or main
if [ "$BRANCH_NAME" = "HEAD" ] || [ "$BRANCH_NAME" = "main" ]; then
    exit 0
fi

# Count words in branch name (split by / and -)
WORDS=$(echo "$BRANCH_NAME" | tr '/' ' ' | tr '-' ' ')
WORD_COUNT=$(echo "$WORDS" | wc -w)

if [ "$WORD_COUNT" -ge 6 ]; then
    echo "ERROR: Branch name must be less than 6 words (found: $WORD_COUNT words)."
    echo "Branch: $BRANCH_NAME"
    echo "Example: feat/playground-drawer"
    exit 1
fi

# Validate branch format
PATTERN="^(feat|fix|docs|refactor|perf|test|chore)/[a-z0-9-]+$"
if ! echo "$BRANCH_NAME" | grep -qE "$PATTERN"; then
    echo "ERROR: Branch name does not match style: <type>/<short-kebab-description>"
    echo "Allowed types: feat, fix, docs, refactor, perf, test, chore"
    echo "Found: $BRANCH_NAME"
    exit 1
fi

exit 0
