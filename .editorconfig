# EditorConfig - consistent formatting across all editors and contributors
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{toml,lock}]
indent_size = 4

[*.{kt,kts}]
indent_size = 4

[*.{rs}]
indent_size = 4

[*.{xml}]
indent_size = 4

[*.{gradle,gradle.kts}]
indent_size = 4

[*.{json}]
indent_size = 2

[*.{svg}]
indent_size = 2
